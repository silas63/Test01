from flask import Flask, render_template_string

app = Flask(__name__)

HTML = """
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Snake</title>

    <style>
        body {
            margin: 0;
            background: #111827;
            color: white;
            font-family: Arial, sans-serif;
            text-align: center;
        }

        h1 {
            color: #22c55e;
            margin-top: 30px;
        }

        #score {
            font-size: 22px;
            margin: 15px;
        }

        canvas {
            background: #1f2937;
            border: 3px solid #22c55e;
            max-width: 90vw;
        }

        button {
            margin-top: 15px;
            padding: 10px 20px;
            border: none;
            border-radius: 8px;
            background: #22c55e;
            color: white;
            font-size: 16px;
            cursor: pointer;
        }

        button:hover {
            background: #16a34a;
        }
    </style>
</head>

<body>

<h1>🐍 Snake</h1>
<div id="score">Punkte: 0</div>

<canvas id="game" width="400" height="400"></canvas>

<br>
<button onclick="restart()">Neustart</button>

<p>Steuerung: ⬆️ ⬇️ ⬅️ ➡️ oder WASD</p>

<script>
const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");

const size = 20;
const tiles = canvas.width / size;

let snake;
let food;
let direction;
let nextDirection;
let score;
let gameOver;

function restart() {
    snake = [
        {x: 10, y: 10},
        {x: 9, y: 10},
        {x: 8, y: 10}
    ];

    direction = {x: 1, y: 0};
    nextDirection = {x: 1, y: 0};

    score = 0;
    gameOver = false;

    createFood();
    updateScore();
    draw();
}

function createFood() {
    do {
        food = {
            x: Math.floor(Math.random() * tiles),
            y: Math.floor(Math.random() * tiles)
        };
    } while (
        snake.some(part =>
            part.x === food.x && part.y === food.y
        )
    );
}

function updateScore() {
    document.getElementById("score").textContent =
        "Punkte: " + score;
}

function update() {
    if (gameOver) return;

    direction = nextDirection;

    const head = {
        x: snake[0].x + direction.x,
        y: snake[0].y + direction.y
    };

    // Wand getroffen
    if (
        head.x < 0 ||
        head.x >= tiles ||
        head.y < 0 ||
        head.y >= tiles
    ) {
        gameOver = true;
        return;
    }

    // Schlange getroffen
    if (
        snake.some(part =>
            part.x === head.x && part.y === head.y
        )
    ) {
        gameOver = true;
        return;
    }

    snake.unshift(head);

    // Essen gegessen
    if (head.x === food.x && head.y === food.y) {
        score++;
        updateScore();
        createFood();
    } else {
        snake.pop();
    }
}

function draw() {
    ctx.fillStyle = "#1f2937";
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // Essen
    ctx.fillStyle = "#ef4444";
    ctx.fillRect(
        food.x * size,
        food.y * size,
        size - 2,
        size - 2
    );

    // Schlange
    snake.forEach((part, index) => {
        ctx.fillStyle =
            index === 0 ? "#86efac" : "#22c55e";

        ctx.fillRect(
            part.x * size,
            part.y * size,
            size - 2,
            size - 2
        );
    });

    if (gameOver) {
        ctx.fillStyle = "rgba(0, 0, 0, 0.7)";
        ctx.fillRect(
            0, 0,
            canvas.width,
            canvas.height
        );

        ctx.fillStyle = "white";
        ctx.textAlign = "center";
        ctx.font = "32px Arial";

        ctx.fillText(
            "Game Over!",
            canvas.width / 2,
            canvas.height / 2
        );

        ctx.font = "18px Arial";

        ctx.fillText(
            "Klicke auf Neustart",
            canvas.width / 2,
            canvas.height / 2 + 35
        );
    }
}

document.addEventListener("keydown", event => {
    const key = event.key.toLowerCase();

    if (
        (key === "arrowup" || key === "w") &&
        direction.y !== 1
    ) {
        nextDirection = {x: 0, y: -1};
    }

    if (
        (key === "arrowdown" || key === "s") &&
        direction.y !== -1
    ) {
        nextDirection = {x: 0, y: 1};
    }

    if (
        (key === "arrowleft" || key === "a") &&
        direction.x !== 1
    ) {
        nextDirection = {x: -1, y: 0};
    }

    if (
        (key === "arrowright" || key === "d") &&
        direction.x !== -1
    ) {
        nextDirection = {x: 1, y: 0};
    }
});

restart();

setInterval(() => {
    update();
    draw();
}, 100);
</script>

</body>
</html>
"""


@app.route("/")
def home():
    return render_template_string(HTML)


if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000, debug=True)
